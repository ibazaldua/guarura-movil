<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:orientation="vertical"
  android:layout_width="match_parent"
  android:layout_height="match_parent" android:weightSum="1">

    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:gravity="center_vertical" android:background="@drawable/pie_gris">

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="7dp"
            android:paddingRight="15dp" >

            <ImageView
                android:id="@+id/ImageView01"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/tornillo" />

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginTop="18dp"
                android:minHeight="13dp"
                android:minWidth="13dp"
                android:src="@drawable/tornillo" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imageView1"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/proteccion" >
</ImageView>

        <TextView
            android:id="@+id/textView1"
            style="@style/header_pantallas"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:text="@string/listaNegra"
            android:textAppearance="?android:attr/textAppearanceLarge" android:paddingLeft="15dp">
</TextView>

        <LinearLayout
            android:id="@+id/linearLayout3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical|right"
            android:orientation="vertical"
            android:paddingRight="7dp" >

            <ImageView
                android:id="@+id/ImageView02"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/tornillo" />

            <ImageView
                android:id="@+id/ImageView03"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginTop="18dp"
                android:minHeight="13dp"
                android:minWidth="13dp"
                android:src="@drawable/tornillo" />
        </LinearLayout>

    </LinearLayout>

    <ExpandableListView
        android:id="@+id/elvElementos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fondo"
        android:cacheColorHint="#00000000" android:layout_weight="1">
</ExpandableListView>

    <FrameLayout
        android:id="@+id/frameLayout1"
        android:layout_width="match_parent"
        android:layout_height="20dp" android:background="@drawable/pie_gris">

    </FrameLayout>
    
</LinearLayout>
