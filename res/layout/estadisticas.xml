<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:weightSum="1" android:orientation="vertical" android:layout_gravity="center_vertical" android:layout_height="match_parent" android:background="@drawable/fondo">

    <LinearLayout
        android:id="@+id/linearLayout7"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" >

        <LinearLayout
            android:id="@+id/LinearLayout03"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/pie_gris"
            android:gravity="center_vertical" >

            <LinearLayout
                android:id="@+id/LinearLayout01"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingLeft="7dp"
                android:paddingRight="15dp" >

                <ImageView
                    android:id="@+id/ImageView01"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/tornillo" />

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginTop="18dp"
                    android:minHeight="13dp"
                    android:minWidth="13dp"
                    android:src="@drawable/tornillo" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LinearLayout02"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical|right"
                android:orientation="vertical"
                android:paddingRight="7dp" >

                <ImageView
                    android:id="@+id/ImageView02"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/tornillo" />

                <ImageView
                    android:id="@+id/ImageView03"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginTop="18dp"
                    android:minHeight="13dp"
                    android:minWidth="13dp"
                    android:src="@drawable/tornillo" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/imageView1"
            android:layout_width="150dp"
            android:layout_height="130dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-55dp"
            android:src="@drawable/logo_b" />

        <FrameLayout
            android:id="@+id/frameLayout1"
            android:layout_width="match_parent"
            android:layout_height="match_parent" android:layout_weight="1" android:layout_marginTop="-40dp">

            <TableLayout
                android:id="@+id/tableLayout1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical|center_horizontal" >

                <TableRow
                    android:id="@+id/tableRow1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal">

                    <LinearLayout
                        android:id="@+id/linearLayout2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical" >

                        <ImageButton
                            android:contentDescription="@string/corta_llamada"
                            android:id="@+id/cmdCortarLlamadas"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/menu_frecuente" />

                        <TextView
                            android:id="@+id/textView2"
                            style="@style/titulos_menus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/frecuentes" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linearLayout3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingLeft="40dp" >

                        <ImageButton
                            android:contentDescription="@string/totalLlamadas"
                            android:id="@+id/cmdTotalLlamadas"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/menu_consulta" />

                        <TextView
                            android:id="@+id/TextView02"
                            style="@style/titulos_menus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_llamadas" />
                    </LinearLayout>
                </TableRow>

                <TableRow
                    android:id="@+id/tableRow2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal" >

                    <LinearLayout
                        android:id="@+id/linearLayout4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical" >

                        <ImageButton
                            android:contentDescription="@string/listaNegra"
                            android:id="@+id/cmdListaNegra"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/menu_lista_negra" />

                        <TextView
                            android:id="@+id/TextView03"
                            style="@style/titulos_menus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/listaNegra" />
                    </LinearLayout>
                </TableRow>

                <TableRow
                    android:id="@+id/tableRow3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal" >

                    <LinearLayout
                        android:id="@+id/linearLayout5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical" >

                        <ImageButton
                            android:contentDescription="@string/configuracion"
                            android:id="@+id/cmdConfiguracion"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/menu_configuracion" />

                        <TextView
                            android:id="@+id/TextView04"
                            style="@style/titulos_menus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/configuracion" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linearLayout6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingLeft="40dp" >

                        <ImageButton
                            android:contentDescription="@string/acerca_de"
                            android:id="@+id/cmdAcercaDe"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/menu_acercade" />

                        <TextView
                            android:id="@+id/TextView05"
                            style="@style/titulos_menus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/acerca_de" />
                    </LinearLayout>
                </TableRow>
            </TableLayout>

            <LinearLayout
                android:id="@+id/linearLayout1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical|center_horizontal"
                android:orientation="horizontal" >
            </LinearLayout>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/FrameLayout01"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:background="@drawable/pie_gris">
        </FrameLayout>

    </LinearLayout>
    
</LinearLayout>
