<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:orientation="vertical"
  android:layout_width="fill_parent"
  android:layout_height="fill_parent">
  
	<LinearLayout
	    xmlns:android="http://schemas.android.com/apk/res/android"
	    android:layout_width="fill_parent"
	    android:layout_height="55dp"
	    android:background="@drawable/pie_gris"
	    android:gravity="center_vertical"
	    android:orientation="horizontal" >

		<LinearLayout
		    android:id="@+id/LinearLayout02"
		    android:layout_width="wrap_content"
		    android:layout_height="match_parent"
		    android:gravity="center_vertical"
		    android:orientation="vertical"
		    android:paddingLeft="7dp"
		    android:paddingRight="15dp" >

		    <ImageView
		        android:id="@+id/ImageView04"
		        android:layout_width="13dp"
		        android:layout_height="13dp"
		        android:src="@drawable/tornillo" />

		    <ImageView
		        android:id="@+id/imageView2"
		        android:layout_width="13dp"
		        android:layout_height="13dp"
		        android:layout_marginTop="18dp"
		        android:minHeight="13dp"
		        android:minWidth="13dp"
		        android:src="@drawable/tornillo" />
		</LinearLayout>

		<ImageView
		    android:id="@+id/ImageView01"
		    android:layout_width="45dp"
		    android:layout_height="45dp"
		    android:src="@drawable/consulta" />

	    <TableLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
	        <TableRow>

	            <TextView
	                android:id="@+id/TextView01"
	                style="@style/header_pantallas"
	                android:layout_width="match_parent"
	                android:layout_height="wrap_content"
	                android:gravity="center"
	                android:text="@string/total_llamadas"
	                android:textStyle="bold" android:paddingLeft="15dp"/>
	        </TableRow>

	        <TableRow>

	            <LinearLayout
	                android:id="@+id/LinearLayout01"
	                android:layout_width="match_parent"
	                android:layout_height="wrap_content"
	                android:gravity="center_horizontal"
	                android:weightSum="1" android:paddingLeft="20dp">

	                <TextView
	                    android:id="@+id/lblFechaIni"
	                    android:layout_width="wrap_content"
	                    android:layout_height="wrap_content"
	                    android:layout_weight="0.07"
	                    android:clickable="true"
	                    android:shadowColor="#000000"
	                    android:shadowDx="2"
	                    android:shadowDy="2"
	                    android:shadowRadius="2"
	                    android:text="31/12/2011"
	                    android:textColor="#0e9aff" />

	                <TextView
	                    android:id="@+id/lblAl"
	                    android:layout_width="wrap_content"
	                    android:layout_height="wrap_content"
	                    android:layout_weight="0.07"
	                    android:paddingLeft="5dp"
	                    android:shadowColor="#A9A9A9"
	                    android:shadowDx="3"
	                    android:shadowDy="3"
	                    android:shadowRadius="2"
	                    android:text="al"
	                    android:textColor="#000000" />

	                <TextView
	                    android:id="@+id/lblFechaFin"
	                    android:layout_width="wrap_content"
	                    android:layout_height="wrap_content"
	                    android:layout_weight="0.06"
	                    android:clickable="true"
	                    android:gravity="right"
	                    android:paddingLeft="5dp"
	                    android:shadowColor="#000000"
	                    android:shadowDx="2"
	                    android:shadowDy="2"
	                    android:shadowRadius="2"
	                    android:text="31/12/2011"
	                    android:textColor="#0e9aff" />

	            </LinearLayout>

	        </TableRow>

	    </TableLayout>

	    <LinearLayout
	        android:id="@+id/linearLayout3"
	        android:layout_width="match_parent"
	        android:layout_height="match_parent"
	        android:gravity="center_vertical|right"
	        android:orientation="vertical"
	        android:paddingRight="7dp" >

	        <ImageView
	            android:id="@+id/ImageView02"
	            android:layout_width="13dp"
	            android:layout_height="13dp"
	            android:src="@drawable/tornillo" />

	        <ImageView
	            android:id="@+id/ImageView03"
	            android:layout_width="13dp"
	            android:layout_height="13dp"
	            android:layout_marginTop="18dp"
	            android:minHeight="13dp"
	            android:minWidth="13dp"
	            android:src="@drawable/tornillo" />
	    </LinearLayout>

	</LinearLayout>

    <FrameLayout android:id="@+id/frameLayout2" android:layout_width="match_parent" android:layout_height="match_parent">
        <TabHost android:id="@android:id/tabhost" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Todas">
            <LinearLayout android:layout_width="match_parent" android:id="@+id/linearLayout2" android:layout_height="match_parent" android:orientation="vertical">
                <TabWidget android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@android:id/tabs" android:tabStripEnabled="true" android:visibility="visible"></TabWidget>
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:id="@android:id/tabcontent">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/tab1" android:orientation="vertical" android:weightSum="1">
                        <ListView android:layout_width="match_parent" android:id="@+id/lsvResultado" android:layout_weight=".87" android:layout_height="match_parent" android:background="@drawable/fondo" android:cacheColorHint="#00000000"></ListView>

                        <RelativeLayout
                            android:id="@+id/relativeLayout1"
                            android:layout_width="match_parent"
                            android:layout_height="57dp"
                            android:background="@drawable/pie_gris">

                            <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:layout_alignParentTop="true" android:textStyle="bold" android:text="@string/totalLlamadas" android:textAppearance="?android:attr/textAppearanceMedium" android:layout_alignParentLeft="true" android:id="@+id/textView2" android:layout_toLeftOf="@+id/lblTotalLlamadas" style="@style/totales"></TextView>
                            <TextView android:layout_height="wrap_content" android:layout_width="wrap_content" android:textStyle="bold" android:layout_below="@+id/textView2" android:text="@string/duracionLlamdas" android:textAppearance="?android:attr/textAppearanceMedium" android:layout_alignParentLeft="true" android:id="@+id/textView3" android:layout_toLeftOf="@+id/lblDuracionTotal" style="@style/totales"></TextView>
                            <TextView android:id="@+id/lblTotalLlamadas" android:typeface="monospace" android:layout_height="wrap_content" android:ellipsize="middle" android:textAppearance="?android:attr/textAppearanceMedium" android:layout_above="@+id/textView3" android:layout_alignLeft="@+id/lblDuracionTotal" android:layout_alignRight="@+id/lblDuracionTotal" android:gravity="center_horizontal" android:layout_width="match_parent" android:text="0" style="@style/totales"></TextView>
                            <TextView android:layout_width="150dp" android:id="@+id/lblDuracionTotal" android:gravity="center_horizontal" android:typeface="monospace" android:layout_height="wrap_content" android:textAppearance="?android:attr/textAppearanceMedium" android:layout_below="@+id/lblTotalLlamadas" android:layout_alignParentRight="true" android:text="00:00:00" style="@style/totales"></TextView>
                        </RelativeLayout>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </TabHost>
    </FrameLayout>
    
</LinearLayout>
