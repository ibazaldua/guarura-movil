<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="1" >

    <LinearLayout
        android:id="@+id/linearLayout1"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/pie_gris"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="7dp" android:paddingRight="15dp">

            <ImageView
                android:id="@+id/ImageView01"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/tornillo"/>

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/tornillo" android:minHeight="13dp" android:minWidth="13dp" android:layout_marginTop="18dp"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/imageView1"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:src="@drawable/frecuentes" />

        <TextView
            android:id="@+id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:shadowColor="#A9A9A9"
            android:shadowDx="5"
            android:shadowDy="3"
            android:text="@string/frecuentes"
            android:lines="1" 
            android:textColor="#000000" 
            android:shadowRadius="2" 
            android:textSize="20dp" 
            android:textStyle="bold" style="@style/header_pantallas" android:paddingLeft="15dp">

</TextView>

        <LinearLayout
            android:id="@+id/linearLayout3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical|right"
            android:orientation="vertical" android:paddingRight="7dp">

            <ImageView
                android:id="@+id/ImageView02"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/tornillo" />

            <ImageView
                android:id="@+id/ImageView03"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginTop="18dp"
                android:minHeight="13dp"
                android:minWidth="13dp"
                android:src="@drawable/tornillo" />
        </LinearLayout>

    </LinearLayout>

    <ListView
        android:id="@+id/lsvElementos"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/fondo"
        android:cacheColorHint="#00000000" >

</ListView>

    <FrameLayout
        android:id="@+id/frameLayout1"
        android:layout_width="match_parent"
        android:layout_height="20dp" android:background="@drawable/pie_gris">

    </FrameLayout>
    
</LinearLayout>
